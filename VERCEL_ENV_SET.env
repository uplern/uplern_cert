# =========================================================================
# UPLERN PRODUCTION ENVIRONMENT VARIABLES (FOR VERCEL)
# =========================================================================
# Copy these and paste them into your Vercel Project Settings -> Environment Variables.

# --- SHARED / BACKEND ---
MONGODB_URI=YOUR_NEW_MONGODB_URI_HERE
JWT_SECRET=uplern_prod_secret_2026_secure_random_string
JWT_EXPIRES_IN=7d
PORT=5000

# --- URL CONFIGURATION (Update with your actual Vercel Domain) ---
# Production API Base URL
# Using relative path to leverage Vercel's rewrite engine
VITE_API_BASE_URL=/api
FRONTEND_BASE_URL=https://uplern-cert.vercel.app
PUBLIC_BASE_URL=https://uplern-cert.vercel.app
CORS_ORIGINS=https://uplern-cert.vercel.app

# --- FRONTEND SPECIFIC ---
# Setting this to /api leverage the vercel.json rewrites for a unified domain

# --- SYSTEM ---
RATE_LIMIT_MAX=200
NODE_ENV=production
